# ============================================================
# 育儿知识库 - 环境变量模板
# 用法：复制本文件为 .env，然后按下面的说明把值填上。
# 最省事的做法：把 kb_per 的 .env 整体复制过来，只改「本项目隔离项」那几行。
# ============================================================

# ---------------- 大模型（OpenAI 兼容接口，推荐百炼） ----------------
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash
OPENAI_API_KEY=sk-在这里填你的百炼APIKey
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1

# ---------------- 向量模型 BGE-M3（本地路径 + 设备） ----------------
BGE_M3_PATH=D:\ai_models\bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
EMBEDDING_DIM=1024

# ---------------- 精排模型 bge-reranker-large ----------------
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\rerank\BAAI\bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ---------------- Milvus 向量库 ----------------
MILVUS_URL=http://192.168.10.119:19530

# ======== 本项目隔离项：与 kb_per 分开，互不污染 ========
CHUNKS_COLLECTION=kb_parenting_chunks
MONGO_DB_NAME=parenting_kb
MINIO_IMG_DIR=/parenting-images

# ---------------- MongoDB 会话历史 ----------------
MONGO_URL=mongodb://127.0.0.1:27017

# ---------------- MinIO 对象存储（存 PDF 解析出的图片） ----------------
MINIO_ENDPOINT=192.168.10.119:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_SECURE=False

# ---------------- MinerU 在线解析（把 PDF 转 Markdown） ----------------
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=在这里填你的MinerU Token

# ---------------- 模型下载源（国内走 modelscope 更快） ----------------
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache

# ---------------- 日志配置 ----------------
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
